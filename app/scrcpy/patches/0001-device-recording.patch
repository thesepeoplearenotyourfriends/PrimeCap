+++ server/src/main/java/com/genymobile/scrcpy/device/PacketSink.java
@@ -0,0 +1,16 @@
+package com.genymobile.scrcpy.device;
+
+import com.genymobile.scrcpy.util.Codec;
+import android.media.MediaCodec;
+import android.media.MediaFormat;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+
+public interface PacketSink {
+    Codec getCodec();
+    void writeAudioHeader() throws IOException;
+    void writeVideoHeader(Size videoSize) throws IOException;
+    void writeDisableStream(boolean error) throws IOException;
+    void setOutputFormat(MediaFormat format) throws IOException;
+    void writePacket(ByteBuffer buffer, MediaCodec.BufferInfo bufferInfo) throws IOException;
+}
