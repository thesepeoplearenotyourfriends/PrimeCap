@@ -0,0 +1,22 @@
+package com.genymobile.scrcpy;
+
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+
+public final class RecordingCleanup {
+    private static final long SHUTDOWN_TIMEOUT_SECONDS = 15;
+
+    private final CountDownLatch complete = new CountDownLatch(1);
+
+    public void signalComplete() {
+        complete.countDown();
+    }
+
+    public void awaitComplete() {
+        try {
+            complete.await(SHUTDOWN_TIMEOUT_SECONDS, TimeUnit.SECONDS);
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+        }
+    }
+}
--- server/src/main/java/com/genymobile/scrcpy/RecordingShutdownHook.java
+++ server/src/main/java/com/genymobile/scrcpy/RecordingShutdownHook.java
@@ -0,0 +1,21 @@
+package com.genymobile.scrcpy;
+
+import android.os.Looper;
+
+public final class RecordingShutdownHook extends Thread {
+    private final RecordingCleanup cleanup;
+
+    public RecordingShutdownHook(RecordingCleanup cleanup) {
+        super("recording-shutdown");
+        this.cleanup = cleanup;
+    }
+
+    @Override
+    public void run() {
+        Looper mainLooper = Looper.getMainLooper();
+        if (mainLooper != null) {
+            mainLooper.quitSafely();
+        }
+        cleanup.awaitComplete();
+    }
+}
--- server/src/main/java/com/genymobile/scrcpy/device/MediaMuxerWriter.java
+++ server/src/main/java/com/genymobile/scrcpy/device/MediaMuxerWriter.java
@@ -0,0 +1,157 @@
+package com.genymobile.scrcpy.device;
+
+import com.genymobile.scrcpy.audio.AudioCodec;
+import com.genymobile.scrcpy.video.VideoCodec;
+
+import android.media.MediaCodec;
+import android.media.MediaFormat;
+import android.media.MediaMuxer;
+
+import java.io.Closeable;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+public final class MediaMuxerWriter implements Closeable {
+    private static final int MAX_PENDING_SAMPLES = 128;
+    private static final int MAX_PENDING_BYTES = 8 * 1024 * 1024;
+
+    private final MediaMuxer muxer;
+    private final MuxerTrack videoTrack;
+    private final MuxerTrack audioTrack;
+    private final List<MuxerPacket> pendingPackets = new ArrayList<>();
+    private int pendingBytes;
+    private boolean started;
+    private boolean closed;
+    private long firstVideoPts = Long.MIN_VALUE;
+    private long firstAudioPts = Long.MIN_VALUE;
+    private long recordingOrigin;
+    private long lastVideoPts = -1;
+    private long lastAudioPts = -1;
+
+    public MediaMuxerWriter(String path) throws IOException {
+        muxer = new MediaMuxer(path, MediaMuxer.OutputFormat.MUXER_OUTPUT_MPEG_4);
+        videoTrack = new MuxerTrack(this, VideoCodec.H264);
+        audioTrack = new MuxerTrack(this, AudioCodec.AAC);
+    }
+
+    public MuxerTrack getVideoTrack() {
+        return videoTrack;
+    }
+
+    public MuxerTrack getAudioTrack() {
+        return audioTrack;
+    }
+
+    synchronized void setOutputFormat(MuxerTrack track, MediaFormat format) throws IOException {
+        checkOpen();
+        if (track.getIndex() != -1) {
+            return;
+        }
+        if (started) {
+            throw new IOException("Track format changed after MP4 muxing started");
+        }
+        track.setIndex(muxer.addTrack(format));
+        tryStart();
+    }
+
+    synchronized void writePacket(MuxerTrack track, ByteBuffer buffer, MediaCodec.BufferInfo info) throws IOException {
+        checkOpen();
+        if ((info.flags & MediaCodec.BUFFER_FLAG_CODEC_CONFIG) != 0 || info.size == 0) {
+            return;
+        }
+        if (track.getIndex() == -1) {
+            throw new IOException("Encoded sample received before its output format");
+        }
+        if (!started) {
+            bufferPendingPacket(track, buffer, info);
+            if (track == videoTrack && firstVideoPts == Long.MIN_VALUE) {
+                firstVideoPts = info.presentationTimeUs;
+            } else if (track == audioTrack && firstAudioPts == Long.MIN_VALUE) {
+                firstAudioPts = info.presentationTimeUs;
+            }
+            tryStart();
+        } else {
+            writeSample(track, buffer, info);
+        }
+    }
+
+    private void bufferPendingPacket(MuxerTrack track, ByteBuffer buffer, MediaCodec.BufferInfo info) throws IOException {
+        if (pendingPackets.size() >= MAX_PENDING_SAMPLES || pendingBytes + info.size > MAX_PENDING_BYTES) {
+            throw new IOException("Too much encoded data buffered before MP4 muxer startup");
+        }
+        ByteBuffer copy = ByteBuffer.allocateDirect(info.size);
+        ByteBuffer source = buffer.duplicate();
+        source.position(info.offset);
+        source.limit(info.offset + info.size);
+        copy.put(source);
+        copy.flip();
+        MediaCodec.BufferInfo copyInfo = new MediaCodec.BufferInfo();
+        copyInfo.set(0, info.size, info.presentationTimeUs, info.flags);
+        pendingPackets.add(new MuxerPacket(track, copy, copyInfo));
+        pendingBytes += info.size;
+    }
+
+    private void tryStart() {
+        if (videoTrack.getIndex() == -1 || audioTrack.getIndex() == -1
+                || firstVideoPts == Long.MIN_VALUE || firstAudioPts == Long.MIN_VALUE) {
+            return;
+        }
+        recordingOrigin = Math.min(firstVideoPts, firstAudioPts);
+        muxer.start();
+        started = true;
+        flushPendingPackets();
+    }
+
+    private void flushPendingPackets() {
+        Collections.sort(pendingPackets, new MuxerPacketComparator());
+        for (MuxerPacket packet : pendingPackets) {
+            writeSample(packet.getTrack(), packet.getBuffer(), packet.getBufferInfo());
+        }
+        pendingPackets.clear();
+        pendingBytes = 0;
+    }
+
+    private void writeSample(MuxerTrack track, ByteBuffer buffer, MediaCodec.BufferInfo info) {
+        long pts = info.presentationTimeUs - recordingOrigin;
+        long lastPts = track == videoTrack ? lastVideoPts : lastAudioPts;
+        if (pts <= lastPts) {
+            pts = lastPts + 1;
+        }
+        if (track == videoTrack) {
+            lastVideoPts = pts;
+        } else {
+            lastAudioPts = pts;
+        }
+
+        MediaCodec.BufferInfo muxerInfo = new MediaCodec.BufferInfo();
+        muxerInfo.set(info.offset, info.size, pts, info.flags);
+        muxer.writeSampleData(track.getIndex(), buffer, muxerInfo);
+    }
+
+    private void checkOpen() throws IOException {
+        if (closed) {
+            throw new IOException("MP4 recorder is closed");
+        }
+    }
+
+    @Override
+    public synchronized void close() throws IOException {
+        if (closed) {
+            return;
+        }
+        closed = true;
+        try {
+            if (started) {
+                muxer.stop();
+            }
+        } catch (IllegalStateException e) {
+            throw new IOException("Could not finalize MP4 recording", e);
+        } finally {
+            muxer.release();
+            pendingPackets.clear();
+        }
+    }
+}
