@@ -0,0 +1,58 @@
+package com.genymobile.scrcpy.device;
+
+import com.genymobile.scrcpy.util.Codec;
+
+import android.media.MediaCodec;
+import android.media.MediaFormat;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+
+public final class MuxerTrack implements PacketSink {
+    private final MediaMuxerWriter writer;
+    private final Codec codec;
+    private int index = -1;
+
+    MuxerTrack(MediaMuxerWriter writer, Codec codec) {
+        this.writer = writer;
+        this.codec = codec;
+    }
+
+    @Override
+    public Codec getCodec() {
+        return codec;
+    }
+
+    @Override
+    public void writeAudioHeader() {
+        // MediaMuxer gets codec configuration from the output MediaFormat.
+    }
+
+    @Override
+    public void writeVideoHeader(Size videoSize) {
+        // MediaMuxer gets the video size from the output MediaFormat.
+    }
+
+    @Override
+    public void writeDisableStream(boolean error) throws IOException {
+        throw new IOException("A required recording track was disabled");
+    }
+
+    @Override
+    public void setOutputFormat(MediaFormat format) throws IOException {
+        writer.setOutputFormat(this, format);
+    }
+
+    @Override
+    public void writePacket(ByteBuffer buffer, MediaCodec.BufferInfo bufferInfo) throws IOException {
+        writer.writePacket(this, buffer, bufferInfo);
+    }
+
+    int getIndex() {
+        return index;
+    }
+
+    void setIndex(int index) {
+        this.index = index;
+    }
+}
