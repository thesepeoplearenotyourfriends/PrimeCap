+++ server/src/main/java/com/genymobile/scrcpy/device/MuxerPacket.java
@@ -0,0 +1,21 @@
+package com.genymobile.scrcpy.device;
+
+import android.media.MediaCodec;
+
+import java.nio.ByteBuffer;
+
+final class MuxerPacket {
+    private final MuxerTrack track;
+    private final ByteBuffer buffer;
+    private final MediaCodec.BufferInfo bufferInfo;
+
+    MuxerPacket(MuxerTrack track, ByteBuffer buffer, MediaCodec.BufferInfo bufferInfo) {
+        this.track = track;
+        this.buffer = buffer;
+        this.bufferInfo = bufferInfo;
+    }
+
+    MuxerTrack getTrack() { return track; }
+    ByteBuffer getBuffer() { return buffer; }
+    MediaCodec.BufferInfo getBufferInfo() { return bufferInfo; }
+}
--- server/src/main/java/com/genymobile/scrcpy/device/MuxerPacketComparator.java
+++ server/src/main/java/com/genymobile/scrcpy/device/MuxerPacketComparator.java
@@ -0,0 +1,10 @@
+package com.genymobile.scrcpy.device;
+
+import java.util.Comparator;
+
+final class MuxerPacketComparator implements Comparator<MuxerPacket> {
+    @Override
+    public int compare(MuxerPacket left, MuxerPacket right) {
+        return Long.compare(left.getBufferInfo().presentationTimeUs, right.getBufferInfo().presentationTimeUs);
+    }
+}
